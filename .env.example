# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables, then redeploy.

# Required — Stripe → Developers → API keys. Use sk_test_... until you're ready.
STRIPE_SECRET_KEY=sk_test_...

# Recommended — from the webhook endpoint you create for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Password for /admin (upcoming bookings, cancel & refund). Make it long.
ADMIN_PASSWORD=

# Your live site address, used in redirect URLs and email links.
SITE_URL=https://oahu.bike

# Optional — booking emails via Resend (https://resend.com). Without these,
# Stripe's own receipts and payment notifications still go out.
RESEND_API_KEY=
BOOKING_EMAIL_FROM="Oahu.BIKE <bookings@oahu.bike>"
BOOKING_NOTIFY_EMAIL=

# Optional — contact address shown on the site (defaults to info@oahu.bike).
NEXT_PUBLIC_CONTACT_EMAIL=info@oahu.bike
